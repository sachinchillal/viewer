{
  "name": "viewer",
  "version": "1.0.0",
  "description": "Browser-based viewer for local markdown files",
  "main": "index.js",
  "keywords": [
    "viewer",
    "markdown",
    "browser",
    "local"
  ],
  "scripts": {
    "b": "npm run build",
    "build": "tsc",
    "build:copy": "tsc && npm run copy-public",
    "copy-public": "copyfiles -u 1 \"src/public/**/*\" dist",
    "test": "jest",
    "start": "ts-node src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git@github-per.com:sachinchillal/viewer.git"
  },
  "author": "sachin chillal",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@types/supertest": "^7.2.0",
    "copyfiles": "^2.4.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}